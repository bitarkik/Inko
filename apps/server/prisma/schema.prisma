datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum OrderStatus {
  PENDING_PAYMENT
  QUEUED
  PROCESSING
  READY_TO_PRINT
  PRINTING
  READY_TO_PICKUP
  COMPLETED
  CANCELLED
  NEEDS_ATTENTION
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String
  password  String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id                String    @id @default(uuid())
  name              String
  address           String
  basePrice         Decimal   @db.Decimal(10, 2)
  latitude          Float?
  longitude         Float?
  city              String?
  area              String?
  services          String[]
  openTime          String?
  closeTime         String?
  ownerName         String?
  contactNumber     String?
  email             String?
  plusCode          String?
  payoutMethod      String?
  payoutAccount     String?
  status            String    @default("PENDING")
  isAcceptingOrders Boolean   @default(true)
  lastPingAt        DateTime?
  revokedAt         DateTime?
  revokeReason      String?
  declineReason     String?
  orders            Order[]
  setupCodes        SetupCode[]
  deviceTokens      DeviceToken[]
  createdAt DateTime @default(now())
  updatedAt         DateTime  @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  status        OrderStatus @default(PENDING_PAYMENT)
  fileUrl       String
  totalPages    Int
  colorPages    Int[]
  bwPages       Int[]
  totalPrice    Decimal
  paymentMethod String      @default("bKash")
  copies        Int         @default(1)
  sidedMode     String      @default("Single side")
  paperSize     String      @default("A4")
  colorMode     String      @default("B&W")

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SetupCode {
  id        String   @id @default(uuid())
  code      String   @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  label     String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
}

