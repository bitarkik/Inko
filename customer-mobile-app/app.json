{
  "expo": {
    "name": "PrintIt",
    "slug": "customer-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/printit-icon.png",
    "scheme": "customermobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/printit-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/printit-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.printpanda.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/printit-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/printit-icon.png",
          "imageWidth": 76
        }
      ],
      ["react-native-maps", { "androidGoogleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "displayVersion": "1.0.1",
      "router": {},
      "eas": {
        "projectId": "6ded98be-2d04-429b-8309-3fc6f615bdac"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ded98be-2d04-429b-8309-3fc6f615bdac"
    }
  }
}
